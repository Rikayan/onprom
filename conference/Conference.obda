[PrefixDeclaration]
:		http://www.example.com/dolibarr/
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:		http://www.w3.org/XML/1998/namespace
xsd:		http://www.w3.org/2001/XMLSchema#
data:		http://www.example.org/conference/data
obda:		https://w3id.org/obda/vocabulary#
rdfs:		http://www.w3.org/2000/01/rdf-schema#
onprom:		http://kaos.inf.unibz.it/onprom/


[MappingDeclaration] @collection [[
mappingId conference
target  :data/conference/{conf_id} a :Conference ; :cName "Conference_{conf_id}"^^xsd:string ; :crTime {time_timestamp}^^xsd:dateTime .
source  SELECT DISTINCT ON (process_id) process_id AS conf_id, time_timestamp FROM events ORDER BY process_id, time_timestamp ASC

mappingId paper
target  :data/paper/{case_id} a :Paper ; :title {case_id}^^xsd:string ; :submittedTo :data/conference/{conf_id}; :submittedBy :data/person/Author_{case_id}.
source  SELECT DISTINCT process_id AS conf_id, case_id FROM events

mappingId collectiveAuthor
target  :data/person/Author_{case_id} a :Person ; :pName "Author of {case_id}"^^xsd:string .
source  SELECT DISTINCT case_id FROM events

mappingId person
target  :data/person/{person_id} a :Person ; :pName {person_id}^^xsd:string .
source  SELECT DISTINCT substring(attr_name FROM 'Result by Reviewer (.*)$') AS person_id FROM event_attributes WHERE attr_name LIKE 'Result by Reviewer %' UNION SELECT DISTINCT org_resource AS person_id FROM events WHERE org_resource IS NOT NULL

mappingId assignmentAndReview
target  :data/assignment/{paper}{reviewer} a :Assignment ; :assignedTo :data/person/{reviewer} ; :leadsTo :data/review/{paper}{reviewer} . :data/paper/{paper} :assignment :data/assignment/{paper}{reviewer} . :data/review/{paper}{reviewer} a :Review ; :subTime {time_timestamp}^^xsd:dateTime .
source  SELECT DISTINCT A.case_id AS paper, substring(B.attr_name FROM 'Result by Reviewer (.*)$') AS reviewer, A.time_timestamp FROM events A INNER JOIN event_attributes B ON A.event_id = B.event_id WHERE B.attr_name LIKE 'Result by Reviewer %'

mappingId paperInviteTimes
target  :data/paper/{case_id} :invTime {invite_start}^^xsd:dateTime ; :accTime {invite_acc}^^xsd:dateTime .
source  SELECT case_id, (ARRAY_AGG(time_timestamp ORDER BY time_timestamp ASC))[1] AS invite_start, (ARRAY_AGG(time_timestamp ORDER BY time_timestamp ASC))[2] AS invite_acc FROM events WHERE concept_name = 'invite reviewers' GROUP BY case_id

mappingId decidedPaper
target  :data/decidedPaper/{paper} a :DecidedPaper ; :notifiedBy :data/person/{noted_by} ; :accepted {decision}^^xsd:boolean ; :declTime {time}^^xsd:dateTime . :data/paper/{paper} :decision :data/decidedPaper/{paper} .
source  SELECT e_term.case_id AS paper, e_term.org_resource AS noted_by, e_term.time_timestamp AS time, (MAX(CASE WHEN a.attr_name = 'accepts' THEN a.attr_value::int ELSE 0 END) > MAX(CASE WHEN a.attr_name = 'rejects' THEN a.attr_value::int ELSE 0 END)) AS decision FROM events e_term LEFT JOIN events e_decide ON e_term.case_id = e_decide.case_id AND e_decide.concept_name = 'decide' LEFT JOIN event_attributes a ON e_decide.event_id = a.event_id WHERE e_term.concept_name IN ('accept', 'reject') GROUP BY e_term.case_id, e_term.org_resource, e_term.time_timestamp
]]