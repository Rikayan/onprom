[MappingDeclaration] @collection [[
mappingId	ONPROM_MAPPING_1
target		:Payment/{rowid1m12}/{rowid1m12} a log:Object . 
source		SELECT v1.`rowid` AS `rowid1m12`
			FROM `llx_paiement` v1
			

mappingId	ONPROM_MAPPING_2
target		:Payment/{rowid1m13}/{rowid1m13} log:objectId {rowid1m13}^^xsd:string . 
source		SELECT v1.`rowid` AS `rowid1m13`
			FROM `llx_paiement` v1
			

mappingId	ONPROM_MAPPING_3
target		:corr/DoPayment/{rowid1m12}/{v0}/{rowid1m12}/Payment/{rowid1m12}/{rowid1m12} a log:corr ; log:corr_2_Event :DoPayment/{rowid1m12}/{v0}/{rowid1m12} ; log:corr_2_Object :Payment/{rowid1m12}/{rowid1m12} . 
source		SELECT v1.`rowid` AS `rowid1m12`, REPLACE(CAST(v1.`datec` AS CHAR(30) CHARACTER SET utf8),' ', 'T') AS `v0`
			FROM `llx_paiement` v1
			WHERE v1.`datec` IS NOT NULL
			

mappingId	ONPROM_MAPPING_4
target		:corr/DoInvoice/{fk_facture1m26}/{v0}/{fk_facture1m26}/Payment/{fk_paiement1m32}/{fk_paiement1m32} a log:corr ; log:corr_2_Event :DoInvoice/{fk_facture1m26}/{v0}/{fk_facture1m26} ; log:corr_2_Object :Payment/{fk_paiement1m32}/{fk_paiement1m32} . 
source		SELECT v1.`fk_facture` AS `fk_facture1m26`, v1.`fk_paiement` AS `fk_paiement1m32`, REPLACE(CAST(v2.`datec` AS CHAR(30) CHARACTER SET utf8),' ', 'T') AS `v0`
			FROM `llx_paiement_facture` v1, `llx_facture` v2
			WHERE (v2.`datec` IS NOT NULL AND v1.`fk_paiement` IS NOT NULL AND v1.`fk_facture` = v2.`rowid`)
			

